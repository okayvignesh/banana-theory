MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=banana_theory

# Basic protection for /admin (user:pass, base64-decoded server-side)
ADMIN_USER=admin
ADMIN_PASS=change-me

# oracle-uploadthing (self-hosted upload service)
# Deploy https://github.com/.../oracle-uploadthing and paste the base URL + token here.
UPLOAD_API_URL=https://your-oracle-uploadthing.vercel.app/api/upload
UPLOAD_API_TOKEN=your-api-token
UPLOAD_PROJECT_NAME=banana-theory
